# SolarFlow Dashboard - Environment Variables

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Google Maps API Key Placeholder (Required for Satellite Rooftop Polygon Tracing)
# Get a key from Google Cloud Console with Maps JavaScript API & Geometry Library enabled:
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
