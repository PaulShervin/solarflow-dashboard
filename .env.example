# SolarFlow Dashboard - Environment Variables

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Map & Geocoding Provider Configuration
# Options for MAP_PROVIDER / VITE_MAP_PROVIDER: "google" | "osm"
# Options for GEOCODING_PROVIDER / VITE_GEOCODING_PROVIDER: "google" | "nominatim"
MAP_PROVIDER=google
VITE_MAP_PROVIDER=google

GEOCODING_PROVIDER=google
VITE_GEOCODING_PROVIDER=google

# Google Maps API Key Placeholder (Required when MAP_PROVIDER=google)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# OpenStreetMap / Nominatim Configuration (Used when MAP_PROVIDER=osm or GEOCODING_PROVIDER=nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

NOMINATIM_USER_AGENT=SolarFlowDashboard/1.0 (contact@solarflow.example)
VITE_NOMINATIM_USER_AGENT=SolarFlowDashboard/1.0 (contact@solarflow.example)

OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
